{
  "name": "wayforth-sdk",
  "version": "0.8.12",
  "description": "TypeScript/JavaScript SDK for the Wayforth API runtime — search, execute, and pay for 5,000+ APIs in one call",
  "keywords": [
    "wayforth",
    "api",
    "sdk",
    "ai",
    "agents",
    "mcp",
    "llm",
    "translation",
    "search"
  ],
  "homepage": "https://wayforth.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WayforthOfficial/wayforth-ts.git"
  },
  "license": "BSL-1.1",
  "author": "Wayforth Technologies Inc.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
